// Prisma schema for the patrimoine dashboard.
//
// SQLite by default (single file, trivial to back up / move to a new
// machine). To migrate to Postgres later (e.g. on GCP + Cloud SQL):
//   1. change `provider = "sqlite"` to `provider = "postgresql"` below
//   2. point DATABASE_URL at the Postgres instance
//   3. run `npx prisma migrate dev` to generate a fresh migration
// The rest of the app talks to Prisma's API only, so nothing else changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single-user app: exactly one row is expected to ever exist here, but the
// model stays normal (no hardcoded id) so nothing breaks if that changes.
model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  totpSecret     String // encrypted at rest is overkill for a single local secret column already behind auth, kept plain in DB file
  totpEnabled    Boolean  @default(false)
  failedLogins   Int      @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// SQLite has no native enum type, so `type` is a plain String here. The set
// of allowed values (ASSURANCE_VIE, LIVRET, CTO, PEA, PER, AUTRE) is enforced
// in the application layer (see accountTypeValues in src/lib/validation.ts).
model Account {
  id          String   @id @default(cuid())
  name        String // e.g. "Livret A", "PEA Bourse Direct"
  type        String
  institution String? // e.g. "Boursorama", "Fortuneo" (optional)
  note        String?
  archived    Boolean  @default(false)
  emergencyFund Boolean @default(false) // counts toward the safety cushion ("matelas de sécurité")
  contributions Float? // total paid in (net deposits), for accounts without positions: gain = value - contributions
  // Physical assets (types OR and VEHICULE): JSON description used to value
  // them (coins and bars for gold; make, model, year, mileage for a vehicle).
  details     String?
  // File name of the account's photo in data/photos (vehicles).
  photo       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     Entry[]
  positions   Position[]
  recurringExpenses RecurringExpense[]

  @@index([type])
}

// One manually-entered valuation snapshot for an account at a given date.
model Entry {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime // the valuation date (day granularity)
  value     Float // balance / valuation in EUR at that date
  invested  Float? // money put in and still held at that date (cost basis), when known: period gain = Δvalue − Δinvested
  note      String?
  createdAt DateTime @default(now())

  @@unique([accountId, date])
  @@index([accountId, date])
}

// One instrument holding within an account at a given snapshot date, e.g.
// one row of a Trade Republic "net worth statement" PDF. A full re-import
// for a given (accountId, date) replaces that date's positions wholesale
// (see /api/import/trade-republic), since each snapshot is a complete
// picture of the account's holdings on that day, not an incremental delta.
model Position {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime // the snapshot date (day granularity, matches an Entry.date)
  name      String // instrument name, e.g. "NVIDIA Corp."
  isin      String? // null for instruments without one (e.g. some crypto lines)
  quantity  Float
  price     Float // price per unit in EUR at that date
  value     Float // quantity * price, as stated on the source statement
  costBasis Float? // average purchase price per unit in EUR (PRU), when known
  createdAt DateTime @default(now())

  @@unique([accountId, date, name])
  @@index([accountId, date])
}

// App-wide preferences as simple key/value pairs (e.g. monthly expenses
// used to size the safety cushion). Values are stored as strings.
model Setting {
  key   String @id
  value String
}

// A recurring expense ("charge") shown on the monthly expenses calendar.
// Its monthly equivalent (amount / months between occurrences) sizes the
// safety cushion. `category` and `frequency` are validated in the app layer
// (see src/lib/expenses.ts), since SQLite has no enums.
model RecurringExpense {
  id         String   @id @default(cuid())
  name       String
  amount     Float // EUR per occurrence
  category   String
  dayOfMonth Int? // 1-31, null = no fixed day (e.g. groceries)
  frequency  String   @default("MENSUEL") // MENSUEL | TRIMESTRIEL | SEMESTRIEL | ANNUEL
  startMonth Int      @default(1) // 1-12, first month of occurrence for non-monthly charges
  active     Boolean  @default(true)
  note       String?
  // Destination account of a savings transfer (e.g. 170 €/month to the Livret Bleu).
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // A savings line that still counts in the safety cushion, because it keeps
  // being paid even in a hard month (e.g. a fixed assurance vie contribution).
  inCushion  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accountId])
}

// A conversation with the assistant (Conseiller). `messages` is a JSON array
// of { role, content, notes? }, kept server-side so every device sees it.
model AssistantConversation {
  id        String   @id @default(cuid())
  title     String
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Something the assistant learned about the user and keeps for later
// conversations (saved by the assistant itself or added in its settings).
model AssistantMemory {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
