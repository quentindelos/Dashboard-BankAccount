# Copy this file to .env and fill in real values. NEVER commit .env.

# SQLite by default (file lives in the mounted "data" volume so it survives
# container restarts/rebuilds). To switch to Postgres later (e.g. on GCP with
# Cloud SQL), change the provider in prisma/schema.prisma to "postgresql" and
# point DATABASE_URL at your Postgres instance.
DATABASE_URL="file:../data/dashboard.db"

# Secret used to encrypt session cookies (iron-session). MUST be a random
# string of at least 32 characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"

# Public base URL of the app. Used to mark the session cookie "secure" and to
# build the TOTP issuer label shown in the authenticator app.
APP_URL="http://localhost:3000"

# Set to "true" only when the app is served over HTTPS (e.g. behind Caddy on
# your domain, or on Cloud Run). When true, the session cookie requires HTTPS.
# Keep "false" for plain local/LAN http access (e.g. http://raspberrypi.local:3000).
COOKIE_SECURE="false"

NODE_ENV="production"

# Optional: enables the "Conseiller" page (questions about your finances).
# Set ONE of the two keys. Gemini: an API key from a Google Cloud project with
# billing enabled (restricted to "Generative Language API"); GEMINI_MODEL
# overrides the model (default gemini-3.8-flash). Claude (Anthropic):
# create a key at https://console.anthropic.com/settings/keys
# Your financial snapshot is sent to that provider with each question.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
